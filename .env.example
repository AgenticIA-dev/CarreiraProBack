# =============================================================================
# VoceUP — Backend — Variáveis de ambiente
# Copie este arquivo para .env (ou .env.local, que tem precedência) e preencha
# com valores reais. NUNCA cometer .env/.env.local no controle de versão.
# NUNCA usar valores reais aqui.
#
# Este projeto é o BACKEND (API): é o único lugar que deve ter a conexão com
# o banco, o segredo dos tokens, as credenciais SMTP e os segredos do Mercado
# Pago. O projeto do frontend nunca deve receber nenhuma dessas variáveis.
# =============================================================================

# --- CORS ----------------------------------------------------------------------
# Origem do projeto frontend (produção: https://www.voceup.com.br,https://voceup.com.br), autorizada a
# chamar esta API pelo navegador. Aceita várias, separadas por vírgula (ex.:
# https://www.voceup.com.br,https://voceup.com.br) — a 1ª é usada nos
# links de e-mail e no retorno do Mercado Pago. Sem isso em produção, o CORS
# rejeita todas as origens (ver src/lib/http/cors.ts). Origem bloqueada aparece
# nos logs como "[CORS] Origem bloqueada".
FRONTEND_ORIGIN=http://localhost:3000

# --- Banco de dados (PostgreSQL 13+, via TypeORM) --------------------------------
# Connection string. Ex.: postgres://usuario:senha@localhost:5432/voceup
DATABASE_URL=
# "true" para conectar com SSL (bancos gerenciados normalmente exigem).
DATABASE_SSL=false
# "false" só se o provedor usar certificado autoassinado.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Conexões por instância (mantenha baixo em serverless).
DATABASE_POOL_MAX=5
# "true" para logar todas as queries (só para depuração).
DATABASE_LOGGING=false

# --- Autenticação ----------------------------------------------------------------
# Segredo para assinar os access tokens (JWT HS256). Aleatório, com pelo menos
# 32 caracteres — ex.: `openssl rand -base64 48`. Trocar este valor encerra
# todas as sessões (os access tokens emitidos deixam de valer).
JWT_SECRET=

# --- E-mail (SMTP) -----------------------------------------------------------------
# Usado para os e-mails de convite pós-compra e recuperação de senha. Sem
# SMTP_HOST, em desenvolvimento os e-mails são impressos no console; em
# produção não são enviados (erro no log).
SMTP_HOST=
SMTP_PORT=587
# "true" para TLS direto (porta 465); "false" usa STARTTLS (porta 587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=VoceUP <no-reply@voceup.com.br>
# E-mail de atendimento: recebe as respostas dos clientes e aparece no rodapé dos e-mails.
EMAIL_REPLY_TO=

# --- Mercado Pago (checkout e pagamentos) ---------------------------------------
# Access token da aplicação no Mercado Pago (painel de credenciais), usado para
# criar preferências de pagamento e consultar pagamentos pela API.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo exibido no painel de configuração do webhook do Mercado Pago, usado
# para validar o header `x-signature` das notificações.
# Validação conferida com a documentação oficial em 29/10/2026
# (https://www.mercadopago.com.br/developers/pt/docs/your-integrations/notifications/webhooks).
MERCADOPAGO_WEBHOOK_SECRET=

# --- Checkout (venda direta, sem marketplace) ------------------------------------
# Preço cobrado pelo acesso ao VoceUP, em reais (formato decimal, ex.: 97.00).
# Definido SEMPRE no servidor — nunca aceito do cliente.
CHECKOUT_PRODUCT_PRICE_BRL=
# Título exibido no Checkout Pro do Mercado Pago. Opcional.
CHECKOUT_PRODUCT_TITLE=VoceUP — Acesso completo
# Duração do acesso comprado: número de meses (ex.: 12) ou "vitalicio".
# OBRIGATÓRIO — é exibido na página de compra/Termos e aplicado pelo sistema
# (o acesso fica inativo ao vencer; uma nova compra renova).
CHECKOUT_ACCESS_MONTHS=

# --- URL pública deste backend --------------------------------------------------
# Usada para montar as back_urls/notification_url da preferência de pagamento
# (produção: https://api.voceup.com.br). Sem o app rodando ainda num domínio
# definitivo, use a própria URL do deploy do backend. (Nome antigo, ainda
# aceito: NEXT_PUBLIC_APP_URL.)
API_PUBLIC_URL=http://localhost:3001

# --- Servidor HTTP -----------------------------------------------------------------
# Porta e interface em que o servidor Node escuta.
# HOST vazio = todas as interfaces IPv4 + IPv6 (recomendado no desenvolvimento:
# evita atraso no Windows, onde "localhost" resolve primeiro para ::1).
# Em produção atrás do Nginx: HOST=127.0.0.1
PORT=3001
HOST=

# --- IA (geração STAR / feedback de entrevista) ---------------------------------
# AI_PROVIDER=openai + AI_PROVIDER_API_KEY=<chave OpenAI> ativa a análise sênior por IA.
# Sem chave, usa o MockAIProvider (análise heurística local, sem chamadas externas).
# AI_PROVIDER_MODEL: padrão gpt-4o (recomendado para feedback sênior); gpt-4o-mini é
# mais barato, com análise menos profunda.
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# --- Transcrição de áudio --------------------------------------------------------
# TRANSCRIPTION_PROVIDER=whisper (ou openai) + TRANSCRIPTION_PROVIDER_API_KEY ativa a
# transcrição real. Se a chave ficar vazia e AI_PROVIDER=openai, reaproveita
# AI_PROVIDER_API_KEY. Sem nenhuma chave: o simulador usa o reconhecimento de voz do
# navegador (Chrome/Edge/Safari) ou o usuário digita a resposta.
# TRANSCRIPTION_PROVIDER_MODEL: whisper-1 (padrão), gpt-4o-transcribe ou gpt-4o-mini-transcribe.
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_PROVIDER_API_KEY=
TRANSCRIPTION_PROVIDER_MODEL=
