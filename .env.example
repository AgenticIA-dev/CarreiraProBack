# =============================================================================
# CarreiraPro — Backend — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA cometer .env.local no controle de versão. NUNCA usar valores reais aqui.
#
# Este projeto é o BACKEND (API): é o único lugar que deve ter a service
# role key do Supabase e os segredos do Mercado Pago. O projeto do frontend
# nunca deve receber nenhuma dessas variáveis.
# =============================================================================

# --- CORS ----------------------------------------------------------------------
# Origem exata do projeto frontend (ex.: https://app.seudominio.com.br), a
# única autorizada a chamar esta API pelo navegador. Sem isso em produção,
# o CORS rejeita todas as origens (ver src/middleware.ts).
FRONTEND_ORIGIN=http://localhost:3000

# --- Supabase ------------------------------------------------------------------
# URL e chave anônima são as mesmas do projeto frontend (públicas por design —
# a segurança vem de RLS, não do sigilo dessas chaves). A service role key é
# secreta e existe SOMENTE aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Mercado Pago (checkout e pagamentos) ---------------------------------------
# Access token da aplicação no Mercado Pago (painel de credenciais), usado para
# criar preferências de pagamento e consultar pagamentos pela API.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo exibido no painel de configuração do webhook do Mercado Pago, usado
# para validar o header `x-signature` das notificações.
# IMPORTANTE: reconfirme o mecanismo de validação atual na documentação oficial
# (https://www.mercadopago.com.br/developers/pt/docs/your-integrations/notifications/webhooks)
# antes de ir para produção — ver docs/DOCUMENTATION.md, seção "Mercado Pago —
# pendência de verificação".
MERCADOPAGO_WEBHOOK_SECRET=

# --- Checkout (venda direta, sem marketplace) ------------------------------------
# Preço cobrado pelo acesso ao CarreiraPro, em reais (formato decimal, ex.: 97.00).
# Definido SEMPRE no servidor — nunca aceito do cliente.
CHECKOUT_PRODUCT_PRICE_BRL=
# Título exibido no Checkout Pro do Mercado Pago. Opcional.
CHECKOUT_PRODUCT_TITLE=CarreiraPro — Acesso completo

# --- URL pública deste backend --------------------------------------------------
# Usada para montar as back_urls/notification_url da preferência de pagamento
# (ex.: https://api.seudominio.com.br). Sem o app rodando ainda num domínio
# definitivo, use a própria URL do deploy do backend.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- IA (geração STAR / feedback de entrevista) ---------------------------------
# Se vazio, a aplicação usa o MockAIProvider (determinístico, sem chamadas externas).
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# --- Transcrição de áudio --------------------------------------------------------
# Se vazio, a aplicação usa o MockTranscriptionProvider.
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_PROVIDER_API_KEY=
