{
  "name": "carreirapro-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CarreiraPro — backend (API HTTP em Node.js, Hono). Checkout/pagamento (Mercado Pago), IA (STAR/feedback), transcrição, banco de perguntas, conta e administração (PostgreSQL via TypeORM) — ver docs/DOCUMENTATION.md.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --enable-source-maps dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:migrate:revert": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts --revert",
    "seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-questions.ts",
    "user:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/create-user.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "globals": "^17.13.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
